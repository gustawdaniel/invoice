generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URI")
}

enum UserRole {
  admin
  user
}

model users {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  email          String       @unique
  avatar         String
  full_name      String
  roles          UserRole[]   @default([])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  lastVerifiedAt DateTime?
  // address for e-Delivery (e-Doręczenia) of the person, e.g. AE:PL-12345-67890-ABCDE-12
  eDeliveryAddress String     @default("")
  company        companies    @relation(fields: [companyId], references: [id])
  companyId      String       @db.ObjectId
  // further companies the user can switch to; companyId is the default one
  companyIds     String[]     @default([]) @db.ObjectId
  accessLogs     accessLogs[]
  agentKeys      agentKeys[]
}

// API keys for AI agents using the MCP endpoint (/mcp). Only the sha256 of the key is stored.
model agentKeys {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  user       users     @relation(fields: [userId], references: [id])
  userId     String    @db.ObjectId
  name       String
  // first characters of the key, to recognize it in the list
  prefix     String
  hash       String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

enum Country {
  GE
  PL
  GB
}

// prod: legally binding; demo: pre-production with real NIP, no legal effect (test mode of the app);
// test: MF test environment with fake NIPs, only on invoices sent before test mode moved to demo
enum CompanyStatus {
  active
  suspended
  closed
  dissolved
  sold
}

enum KsefEnv {
  test
  demo
  prod
}

model companies {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  tin       String @default("")
  address   String @default("")
  info      String @default("")
  logo      String @default("")
  signature String @default("")

  country                  Country       @default(GE)
  // closed, dissolved and sold companies stay as an archive of their invoices and books
  status                   CompanyStatus @default(active)
  // deprecated: the single KSeF mode before test/live mode, only read by migrations/ksefModes.ts
  ksefEnv                  KsefEnv?
  // AES-256-GCM encrypted KSeF tokens (services/ksef/tokenCrypto.ts), one per environment, like Stripe live/test keys
  ksefTokenEnc             String?
  ksefDemoTokenEnc         String?
  // e.g. "Art. 113 ust. 1 ustawy o VAT", printed and sent when items are VAT exempt
  vatExemptionBasis        String        @default("")
  // last day the company deducted VAT as an active taxpayer ("" = still active unless vatExemptionBasis is set)
  vatActiveTo              String        @default("")
  // court register and statistics numbers, printed on Polish invoices of companies
  krs                      String        @default("")
  regon                    String        @default("")
  // address for e-Delivery (e-Doręczenia) of the company, e.g. AE:PL-12345-67890-ABCDE-12
  eDeliveryAddress         String        @default("")
  // prefilled on new invoices, e.g. bank account or a note about VAT
  defaultIssuePlace        String        @default("")
  defaultIssuerName        String        @default("")
  defaultBankAccountNumber String        @default("")
  defaultPublicNote        String        @default("")

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  users            users[]
  clients          clients[]
  invoices         invoices[]
  bankTransactions bankTransactions[]
  costs            costs[]
  filings          filings[]
  documents        documents[]
  journalEntries   journalEntries[]
}

// Contracts, tax decisions and other company files. A document is either an external link
// (e.g. Google Drive) or a private object in the Spaces bucket, never a public URL.
model documents {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  company    companies @relation(fields: [companyId], references: [id])
  companyId  String    @db.ObjectId
  title      String
  // contract | tax | invoice | accounting | other
  kind       String    @default("other")
  url        String    @default("")
  storageKey String    @default("")
  fileName   String    @default("")
  mimeType   String    @default("")
  size       Int       @default(0)
  note       String    @default("")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model accessLogs {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      users    @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  ip        String
  agent     String
  createdAt DateTime @default(now())
}

model exchangeRates {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  date      String   @unique
  EUR       Float
  PLN       Float
  GBP       Float
  USD       Float
  createdAt DateTime @default(now())
}

model clients {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  company   companies @relation(fields: [companyId], references: [id])
  companyId String    @db.ObjectId

  name   String
  street String
  post   String
  city   String
  tin    String

  tinName String @default("NIP")
  country String @default("Poland")

  invoices invoices[]
}

enum Currency {
  EUR
  PLN
  GBP
  USD
}

enum Language {
  pl
  en
}

enum PaymentForm {
  cash
  prepaid
  d14
  d7
  card
  delivery
  check
  dotpay
  paypal
  payu
  other
}

// "23%" | "19%" | '18%' | "8%" | "5%" | "0%" | "zw." | "exempt." | "np." | "np. EU" | "0% WDT" | "0% Exp." | "o.o."
enum VatRate {
  VAT_23
  VAT_19
  VAT_18
  VAT_8
  VAT_5
  VAT_0
  VAT_zw
  VAT_exempt
  VAT_np
  VAT_npEU
  VAT_0_WDT
  VAT_0_EXP
  VAT_oo
}

type Vat {
  value Float
  name  VatRate
}

enum Unit {
  piece
  service
  hour
  pack
  box
  palette
  t
  kg
  m2
  m3
  km
  mb
  l
  mh
}

type InvoiceItem {
  name     String
  unit     String
  quantity Float
  priceNet Float
  vat      Vat
}

model invoices {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  company   companies @relation(fields: [companyId], references: [id])
  companyId String    @db.ObjectId

  client   clients @relation(fields: [clientId], references: [id])
  clientId String  @db.ObjectId

  number       String
  issueDate    String
  saleDate     String
  deadlineDate String
  issuePlace   String   @default("Tbilisi")
  currency     Currency @default(EUR)
  lang         Language @default(en)

  paymentForm PaymentForm @default(d14)

  items InvoiceItem[]

  issuerName           String  @default("Daniel Gustaw")
  receiverName         String  @default("")
  bankAccountNumber    String
  publicNote           String
  privateNote          String
  vatBankAccountNumber String  @default("")
  paid                 Float
  paymentDate          String?
  // withheld by a foreign client and paid to its own tax office: the invoice is settled when paid + withholdingTax covers it
  withholdingTax       Float   @default(0)
  // issued before KSeF (historical, from another program): a final invoice that is never sent to KSeF
  outsideKsef          Boolean @default(false)

  // false: test mode invoice, listed only in test mode and sent only to KSeF DEMO (no legal effect)
  livemode Boolean @default(true)

  ksefEnv             KsefEnv?
  ksefStatus          String? // 'Accepted' | 'Rejected'
  ksefReferenceNumber String?
  ksefNumber          String?
  ksefSentAt          DateTime?
  ksefXml             String?
  ksefQrUrl           String?
  ksefError           String?

  // name of the agent key that created the invoice through MCP, null when made by a human
  createdByAgent      String?
  // an agent asked to send it to production KSeF, a human approves (sends) or dismisses it in the app
  ksefSendRequestedAt DateTime?
  ksefSendRequestedBy String?
  ksefSendRequestNote String?
}

// Bookkeeping. Every operation on the company's bank accounts, and how it is booked.
// kind: what the money was (see services/books/kinds.ts); status: auto (classified by a rule or an agent),
// confirmed (by the human), review (waiting for the human)
model bankTransactions {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  company      companies @relation(fields: [companyId], references: [id])
  companyId    String    @db.ObjectId
  // stable id from the source (hash of account, date, amount, text and position): loading twice adds nothing
  externalId   String
  bank         String
  account      String
  date         String
  amount       Float
  currency     String    @default("PLN")
  description  String
  bankCategory String    @default("")
  kind         String    @default("unclassified")
  status       String    @default("review")
  invoiceId    String?   @db.ObjectId
  // cost documents this operation pays: one transfer can pay several documents, one document can be paid in parts
  costIds      String[]  @db.ObjectId
  note         String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([companyId, externalId])
}

// Purchase documents: invoices, bills and receipts the company paid
model costs {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  company         companies @relation(fields: [companyId], references: [id])
  companyId       String    @db.ObjectId
  // stable id, e.g. a hash of the source file: loading twice adds nothing
  externalId      String
  supplierName    String
  supplierTin     String    @default("")
  supplierCountry String    @default("PL")
  number          String    @default("")
  issueDate       String
  saleDate        String?
  currency        String    @default("PLN")
  net             Float
  vat             Float     @default(0)
  gross           Float
  // e.g. hosting, software, equipment, travel, accounting, office, marketing, education, other
  category        String    @default("other")
  // a service bought from abroad: VAT settled by the company as import of services
  reverseCharge   Boolean   @default(false)
  // where the original is, e.g. "2021.03 Marzec/faktury otrzymane/ovh.pdf"
  // the original uploaded as a company document (private file, downloadable in the app)
  documentId      String?   @db.ObjectId
  file            String    @default("")
  status          String    @default("review")
  note            String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([companyId, externalId])
}

// What the company owes the authorities: tax returns, JPK files, financial statements, registrations.
// One record per kind and period (e.g. CIT-8 for 2025, JPK_V7M for 2025-09); see services/books/filings.ts
model filings {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  company    companies @relation(fields: [companyId], references: [id])
  companyId  String    @db.ObjectId
  // "<kind>:<period>", stable: loading twice adds nothing
  externalId String
  kind       String
  // "2025" for a year, "2025-09" for a month, "" when it has no period (a registration)
  period     String    @default("")
  // tax office (US), court register (KRS), social security (ZUS)
  authority  String    @default("US")
  dueDate    String?
  status     String    @default("todo")
  filedAt    String?
  // UPO number, KRS document id, or similar proof
  reference  String    @default("")
  // company documents that prove it: the file sent, the UPO, the status report
  documentIds String[] @default([]) @db.ObjectId
  // tax to pay for the period, in PLN
  amount     Float?
  note       String    @default("")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([companyId, externalId])
}

// Hand-made entries of the general ledger: the opening balance, offsets, payroll, write-offs, income tax. Everything else
// in the ledger is derived from bank operations, costs and invoices (services/books/ledger.ts).
type JournalLine {
  account String
  debit   Float   @default(0)
  credit  Float   @default(0)
  // the document a settlement line belongs to, e.g. "cost:<id>" or "invoice:<id>"
  ref     String?
}

model journalEntries {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  company     companies     @relation(fields: [companyId], references: [id])
  companyId   String        @db.ObjectId
  // stable id: loading twice adds nothing
  externalId  String
  date        String
  // opening: the opening balance (the books start on its date); entry: any other
  kind        String        @default("entry")
  description String
  lines       JournalLine[]
  documentId  String?       @db.ObjectId
  status      String        @default("review")
  note        String        @default("")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([companyId, externalId])
}

// Average NBP rates (table A), the rates the books use for foreign currency
model nbpRates {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  currency String
  date     String
  mid      Float
  table    String

  @@unique([currency, date])
}
