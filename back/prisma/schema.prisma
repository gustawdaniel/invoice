generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URI")
}

enum UserRole {
  admin
  user
}

model users {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  email          String       @unique
  avatar         String
  full_name      String
  roles          UserRole[]   @default([])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  lastVerifiedAt DateTime?
  company        companies    @relation(fields: [companyId], references: [id])
  companyId      String       @db.ObjectId
  // further companies the user can switch to; companyId is the default one
  companyIds     String[]     @default([]) @db.ObjectId
  accessLogs     accessLogs[]
  agentKeys      agentKeys[]
}

// API keys for AI agents using the MCP endpoint (/mcp). Only the sha256 of the key is stored.
model agentKeys {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  user       users     @relation(fields: [userId], references: [id])
  userId     String    @db.ObjectId
  name       String
  // first characters of the key, to recognize it in the list
  prefix     String
  hash       String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

enum Country {
  GE
  PL
}

// prod: legally binding; demo: pre-production with real NIP, no legal effect (test mode of the app);
// test: MF test environment with fake NIPs, only on invoices sent before test mode moved to demo
enum KsefEnv {
  test
  demo
  prod
}

model companies {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  tin       String     @default("")
  address   String     @default("")
  info      String     @default("")
  logo      String     @default("")
  signature String     @default("")

  country           Country  @default(GE)
  // deprecated: the single KSeF mode before test/live mode, only read by migrations/ksefModes.ts
  ksefEnv           KsefEnv?
  // AES-256-GCM encrypted KSeF tokens (services/ksef/tokenCrypto.ts), one per environment, like Stripe live/test keys
  ksefTokenEnc      String?
  ksefDemoTokenEnc  String?
  // e.g. "Art. 113 ust. 1 ustawy o VAT", printed and sent when items are VAT exempt
  vatExemptionBasis String   @default("")

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  users     users[]
  clients   clients[]
  invoices  invoices[]
}

model accessLogs {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      users    @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  ip        String
  agent     String
  createdAt DateTime @default(now())
}

model exchangeRates {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  date      String   @unique
  EUR       Float
  PLN       Float
  GBP       Float
  USD       Float
  createdAt DateTime @default(now())
}

model clients {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  company   companies @relation(fields: [companyId], references: [id])
  companyId String    @db.ObjectId

  name   String
  street String
  post   String
  city   String
  tin    String

  tinName String @default("NIP")
  country String @default("Poland")

  invoices invoices[]
}

enum Currency {
  EUR
  PLN
  GBP
  USD
}

enum Language {
  pl
  en
}

enum PaymentForm {
  cash
  prepaid
  d14
  d7
  card
  delivery
  check
  dotpay
  paypal
  payu
  other
}

// "23%" | "19%" | '18%' | "8%" | "5%" | "0%" | "zw." | "exempt." | "np." | "np. EU" | "0% WDT" | "0% Exp." | "o.o."
enum VatRate {
  VAT_23
  VAT_19
  VAT_18
  VAT_8
  VAT_5
  VAT_0
  VAT_zw
  VAT_exempt
  VAT_np
  VAT_npEU
  VAT_0_WDT
  VAT_0_EXP
  VAT_oo
}

type Vat {
  value Float
  name  VatRate
}

enum Unit {
  piece
  service
  hour
  pack
  box
  palette
  t
  kg
  m2
  m3
  km
  mb
  l
  mh
}

type InvoiceItem {
  name     String
  unit     String
  quantity Float
  priceNet Float
  vat      Vat
}

model invoices {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  company   companies @relation(fields: [companyId], references: [id])
  companyId String    @db.ObjectId

  client   clients @relation(fields: [clientId], references: [id])
  clientId String  @db.ObjectId

  number       String
  issueDate    String
  saleDate     String
  deadlineDate String
  issuePlace   String   @default("Tbilisi")
  currency     Currency @default(EUR)
  lang         Language @default(en)

  paymentForm PaymentForm @default(d14)

  items InvoiceItem[]

  issuerName           String  @default("Daniel Gustaw")
  receiverName         String  @default("")
  bankAccountNumber    String
  publicNote           String
  privateNote          String
  vatBankAccountNumber String  @default("")
  paid                 Float
  paymentDate          String?

  // false: test mode invoice, listed only in test mode and sent only to KSeF DEMO (no legal effect)
  livemode             Boolean  @default(true)

  ksefEnv              KsefEnv?
  ksefStatus           String?   // 'Accepted' | 'Rejected'
  ksefReferenceNumber  String?
  ksefNumber           String?
  ksefSentAt           DateTime?
  ksefXml              String?
  ksefQrUrl            String?
  ksefError            String?

  // name of the agent key that created the invoice through MCP, null when made by a human
  createdByAgent       String?
  // an agent asked to send it to production KSeF, a human approves (sends) or dismisses it in the app
  ksefSendRequestedAt  DateTime?
  ksefSendRequestedBy  String?
  ksefSendRequestNote  String?
}
