# Environment for docker-compose.yml. On the server this file is /root/openinvoice.in/.env
# (docker compose reads it automatically). Locally the backend gets the same variables from Infisical
# (`pnpm dev` = `infisical run --env=dev --path=/back`), production values live in Infisical env `prod`.
# Never commit the real .env.

# ---------------------------------------------------------------- Backend (back/src/config.ts)

# MongoDB Atlas connection string, the only database (Prisma). /health returns 503 when it is unreachable.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/invoice

# Signs the app's own login JWTs (back/src/helpers/tokenize.ts). Any long random string:
#   openssl rand -base64 48
# Changing it logs everybody out.
JWT_SECRET=change-me

# Google OAuth client used for "Sign in with Google" (Google Cloud Console > APIs & Services > Credentials).
# The same client id is baked into the frontend build (Dockerfile ARG / deploy.yml build-args).
GOOGLE_CLIENT_ID=244384199602-sqhor9mc08tkl3gkd71k9c46rq38msdd.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...

# DigitalOcean Spaces (S3 compatible) for uploaded files such as logos and signatures (back/src/services/s3.ts).
# Keys: DigitalOcean > API > Spaces Keys. Files are served from https://<SPACE_BUCKET>.<SPACE_ENDPOINT>/...
SPACE_ACCESS_KEY=...
SPACE_SECRET_KEY=...
SPACE_BUCKET=...
SPACE_ENDPOINT=fra1.digitaloceanspaces.com
SPACE_REGION=fra1

# API key for https://exchangeratesapi.io, daily USD/PLN/GBP rates (back/src/controllers/exchange/syncExchangeRate.ts).
EXCHANGE_RATES_API_TOKEN=...

# The app's OWN encryption key, NOT something from the Ministry of Finance. KSeF tokens of every company are stored
# encrypted with it (AES-256-GCM, companies.ksefTokenEnc), because a KSeF token lets anyone issue invoices for that NIP.
# 32 random bytes as base64 or hex:
#   openssl rand -base64 32      (or: openssl rand -hex 32)
# Optional: without it the app works, only connecting KSeF fails.
# Do NOT change it once companies are connected - their stored tokens become unreadable and KSeF must be reconnected.
# Must be the same value wherever tokens are written (server, Infisical prod, ksef:import-token script).
KSEF_SECRET_KEY=...

# NOT read by the backend. KSeF tokens belong to companies and are pasted in the app (Company > KSeF > "Use token").
# Only `pnpm ksef:import-token` reads it, to store a token without the UI. Remove it from env after the import.
# Production tokens: https://ap.ksef.mf.gov.pl/web/tokens/generate-token (Aplikacja Podatnika KSeF)
# Test tokens:       https://ap-test.ksef.mf.gov.pl (KSeF TEST accepts only made-up NIPs, no legal effect)
# A token works only in the environment where it was generated. Format: <reference>|nip-<NIP>|<secret>
# KSEF_TOKEN=
# KSEF_ENV=prod

# ---------------------------------------------------------------- Frontend (build time, front/Dockerfile)

# Backend URL baked into the frontend build. Production: https://api.openinvoice.in (set in deploy.yml).
VITE_API_URL=http://localhost:5000
